# AI API keys are entered in Docus Settings and encrypted in SQLite.
# The master key is never stored in SQLite. If these variables are omitted,
# Docus creates data/.docus-master-key automatically on first API-key save.
# To manage the key yourself, use a 32-byte value encoded as 64 hexadecimal
# characters or base64, and keep it separate from SQLite backups.
# DOCUS_MASTER_KEY=

# Alternatively, point to a mounted secret file containing the same key.
# DOCUS_MASTER_KEY_FILE=/run/secrets/docus_master_key

# Docker binds the host port to localhost by default. Set this only when
# you intentionally want LAN/public access and understand the exposure.
# DOCUS_BIND_ADDRESS=127.0.0.1
# DOCS_PORT=3000

# Bare-metal production defaults to 127.0.0.1. Set HOST explicitly for LAN access.
# HOST=127.0.0.1

# Git author identity used by the vault history feature when the vault repo
# has no local user.name / user.email configured.
# GIT_AUTHOR_NAME=docus
# GIT_AUTHOR_EMAIL=docus@localhost
